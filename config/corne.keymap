#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/reset.h>

#define DEF 0
#define AND 1
#define DIR 2
#define NUM 3
#define PAG 4
#define WRP 5
#define CHK 6
#define SYM 7
#define FUN 8
#define MED 9

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
//    --------------------------------                  -------------------------------
//    |  Q  |  W  |  E  |  R  |  T   |                  |  Y  |  U  |  I  |  O  |  P  |
//    |  A  |  S  |  D  |  F  |  G   |                  |  H  |  J  |  K  |  L  | :/; |
//    |  Z  |  X  |  C  |  V  |  ,   |-------     ------|  .  |  M  |  N  |  B  |  '  |
//    ------------------| AND | RALT | RGUI |     | SPC | CAP |     |------------------
//                      ---------------------     -------------------
                        bindings = <
&trans  &kp Q         &kp W      &lt MED E  &kp R        &kp T         &kp Y         &kp U        &kp I   &kp O   &kp P          &trans
&trans  &lt DIR A     &lt NUM S  &lt WRP D  &lt CHK F    &kp G         &kp H         &kp J        &kp K   &kp L   &kp COLON      &trans
&trans  &mt LCTRL Z   &kp X      &kp C      &mt LSHFT V  &kp COMMA     &kp DOT       &mt RSHFT M  &kp N   &kp B   &mt LCTRL SQT  &trans
                                 &tog AND   &kp RALT     &kp RGUI      &mt RALT SPC  &trans       &trans
                        >;
                };
        };
};
