#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/reset.h>

#define DEF 0
#define AND 1
#define DIR 2
#define NUM 3
#define PAG 4
#define WRP 5
#define CHK 6
#define SYM 7
#define FUN 8
#define MED 9

&mt {
        tapping-term-ms = <400>;
};

/ {
        behaviors {
                semi_swap: grave_escape {
                        compatible = "zmk,behavior-mod-morph";
                        label = "SEMI_SWAP";
                        #binding-cells = <0>;
                        bindings = <&kp COLON>, <&kp SEMI>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                };

                lm: letter_mods {
                        compatible = "zmk,behavior-hold-tap";
                        label = "LETTER_MODS";
                        #binding-cells = <2>;
                        tapping_term_ms = <200>;
                        flavor = "tap-preferred";
                        bindings = <&kp>, <&kp>;
                };
        };

        combos {
                compatible = "zmk,combos";

                combo_esc {
                        timeout-ms = <80>;
                        key-positions = <20 21>;
                        bindings = <&kp ESC>;
                };

                combo_ret {
                        timeout-ms = <80>;
                        key-positions = <19 20>;
                        bindings = <&kp RET>;
                };

                combo_sav {
                        timeout-ms = <50>;
                        key-positions = <18 21>;
                        bindings = <&kp LC(S)>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
//    --------------------------------                  -------------------------------
//    |  Q  |  W  |  E  |  R  |  T   |                  |  Y  |  U  |  I  |  O  |  P  |
//    |  A  |  S  |  D  |  F  |  G   |                  |  H  |  J  |  K  |  L  | :/; |
//    |  Z  |  X  |  C  |  V  |  ,   |-------     ------|  .  |  M  |  N  |  B  |  '  |
//    ------------------| AND | RALT | RGUI |     | SPC | CAP |     |------------------
//                      ---------------------     -------------------
                        bindings = <
&trans  &kp Q         &kp W      &lt MED E  &kp R        &kp T         &kp Y         &kp U        &kp I   &kp O   &kp P          &trans
&trans  &lt DIR A     &lt NUM S  &lt WRP D  &lt CHK F    &kp G         &kp H         &kp J        &kp K   &kp L   &semi_swap     &trans
&trans  &mt LCTRL Z   &kp X      &kp C      &mt LSHFT V  &kp COMMA     &kp DOT       &mt RSHFT M  &kp N   &kp B   &mt LCTRL SQT  &trans
                                 &tog AND   &kp RALT     &kp RGUI      &mt RALT SPC  &trans       &trans
                        >;
                };
        };
};
